# ============================================================
# MentorIA Tech — Variáveis de Ambiente (EXEMPLO)
# ============================================================
# NUNCA envie o arquivo .env real ao GitHub.
# Copie este arquivo como .env e preencha com suas credenciais reais.
# O arquivo .env está listado no .gitignore — nunca será commitado.
# ============================================================

# ------------------------------------------------------------
# Chaves de API — LLMs
# Para usar mais de uma chave do mesmo provedor (pool de rotação),
# separe com vírgula: GEMINI_API_KEYS=chave1,chave2,chave3
# ------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_API_KEYS=

GROQ_API_KEY=
GROQ_API_KEYS=

VOYAGE_API_KEY=

# ------------------------------------------------------------
# Modelos utilizados
# ------------------------------------------------------------
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------
# Limites de contexto e geração
# ------------------------------------------------------------
NOVAMENTE_MAX_CONTEXT_CHARS=28000
NOVAMENTE_MAX_OUTPUT_TOKENS=8192

# ------------------------------------------------------------
# OCI SDK — Oracle Cloud Infrastructure
# Perfil definido em ~/.oci/config
# USE_OCI_VAULT=false → usa variáveis de ambiente (MVP)
# USE_OCI_VAULT=true  → usa OCI Vault Secret (pós-MVP)
# ------------------------------------------------------------
OCI_PROFILE=MENTORIA_TECH
OCI_NAMESPACE=
OCI_COMPARTMENT_OCID=
OCI_BUCKET_ARTIFACTS=mentoria-tech-artifacts
OCI_BUCKET_DOCUMENTS=mentoria-tech-documents
OCI_BUCKET_OBSERVABILITY=mentoria-tech-observability
USE_OCI_VAULT=false
